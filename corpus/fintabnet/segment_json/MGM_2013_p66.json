  "MGM_2013_p66__paragraph_1": {
   "type": "paragraph",
   "bbox": [
    69.0,
    134.5,
    525.0,
    168.1
   ],
   "ocr": "The Company recognizes deferred income tax assets, net of applicable reserves, related to net operating loss\ncarryforwards and certain temporary differences. The Company recognizes future tax benefits to the extent that\nrealization of such benefit is more likely than not. Otherwise, a valuation allowance is applied."
  },
